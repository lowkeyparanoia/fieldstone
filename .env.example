# Fieldstone Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite (Development)
DATABASE_URL=sqlite://data/fieldstone.db

# PostgreSQL (Production)
# DATABASE_URL=postgres://user:password@localhost:5432/fieldstone?sslmode=disable

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-characters

# JWT Token Expiry
JWT_EXPIRY=1h

# Bcrypt Cost (higher = more secure but slower)
BCRYPT_COST=10

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Bind Address
SERVER_HOST=0.0.0.0

# HTTP Server Port
SERVER_PORT=8090

# gRPC Server Port
GRPC_PORT=50051

# Admin UI Path
ADMIN_UI_PATH=./web/admin/dist

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Log Format: json, console
LOG_FORMAT=console

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Max requests per window
RATE_LIMIT_REQUESTS=100

# Window duration in seconds
RATE_LIMIT_WINDOW=60

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Storage Type: local, s3
STORAGE_TYPE=local

# Local Storage Path
STORAGE_LOCAL_PATH=./uploads

# Public URL for files
STORAGE_PUBLIC_URL=http://localhost:8090/files

# S3 Configuration (if STORAGE_TYPE=s3)
# STORAGE_S3_ENDPOINT=s3.amazonaws.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=fieldstone-files
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_USE_SSL=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable WebSocket real-time subscriptions
ENABLE_REALTIME=true

# Enable webhook processing
ENABLE_WEBHOOKS=true

# Enable WASM plugins
ENABLE_PLUGINS=true

# Enable gRPC server
ENABLE_GRPC=true

# =============================================================================
# BACKGROUND JOBS
# =============================================================================

# Number of worker goroutines
JOB_WORKERS=4

# Job queue size
JOB_QUEUE_SIZE=1000

# Retry attempts for failed jobs
JOB_RETRY_ATTEMPTS=3

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# Allowed methods
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
CORS_HEADERS=Accept,Authorization,Content-Type,X-Requested-With

# Max age for preflight cache
CORS_MAX_AGE=300

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache Type: memory, redis
CACHE_TYPE=memory

# Redis Configuration (if CACHE_TYPE=redis)
CACHE_REDIS_ADDR=localhost:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0

# Default Cache TTL
CACHE_DEFAULT_TTL=5m

# Cache Key Prefix (useful for multi-tenancy)
CACHE_KEY_PREFIX=fieldstone

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode (more verbose logging)
DEBUG=false

# Enable request/response logging
LOG_REQUESTS=true

# Hot reload for development
HOT_RELOAD=false
